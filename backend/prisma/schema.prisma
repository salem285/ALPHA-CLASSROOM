datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  STUDENT
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  password          String
  firstName         String
  lastName          String
  role              UserRole      @default(STUDENT)
  isApproved        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  instructedCourses Course[]      @relation("InstructedCourses")
  enrollments       Enrollment[]  @relation("StudentEnrollments")
  submissions       Submission[]  @relation("StudentSubmissions")
  examAttempts      ExamAttempt[] @relation("StudentExamAttempts")
  attendanceRecords AttendanceRecord[] @relation("StudentAttendance")
  announcements     Announcement[]     @relation("UserAnnouncements")
  notifications     Notification[]     @relation("UserNotifications")
  discussionPosts   DiscussionPost[]   @relation("UserDiscussionPosts")

  @@map("users")
}

model Course {
  id           String       @id @default(uuid())
  title        String
  code         String       @unique
  description  String?
  accessCode   String       @default("")
  instructorId String
  instructor   User         @relation("InstructedCourses", fields: [instructorId], references: [id])
  isPublished  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  enrollments  Enrollment[]
  assignments  Assignment[]
  exams        Exam[]
  liveRooms    LiveRoom[]
  recordings      Recording[]
  announcements   Announcement[]
  discussionPosts DiscussionPost[]
  materials       CourseMaterial[]

  @@map("courses")
}

model Enrollment {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  status     String   @default("ACTIVE")
  enrolledAt DateTime @default(now())

  @@unique([courseId, studentId])
  @@map("enrollments")
}

model Assignment {
  id          String       @id @default(uuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  dueDate     DateTime?
  maxScore    Int          @default(100)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  content      String     // link or text solution
  score        Float?
  feedback     String?
  status       String     @default("SUBMITTED") // SUBMITTED, GRADED
  submittedAt  DateTime   @default(now())
  gradedAt     DateTime?

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

model Exam {
  id              String        @id @default(uuid())
  courseId        String
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  durationMinutes Int           // e.g. 30 minutes
  passingScore    Float         @default(50.0)
  totalScore      Float         @default(100.0)
  startTime       DateTime?
  endTime         DateTime?
  isPublished     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  questions       Question[]
  attempts        ExamAttempt[]

  @@map("exams")
}

model Question {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  text          String
  type          String   @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE, TRUE_FALSE
  points        Float    @default(1.0)
  options       Json     // e.g. [{"id": "a", "text": "..."}, {"id": "b", "text": "..."}]
  correctAnswer String   // "a", "b", etc. (Must NOT be sent to students taking the exam)
  orderIndex    Int      @default(0)

  @@map("questions")
}

model ExamAttempt {
  id          String    @id @default(uuid())
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation("StudentExamAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  answers     Json?     // e.g. {"questionId": "selectedOptionId"}
  score       Float?
  isPassed    Boolean?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, AUTO_GRADED

  @@unique([examId, studentId]) // Single attempt policy
  @@map("exam_attempts")
}

model LiveRoom {
  id                String             @id @default(uuid())
  courseId          String
  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  roomName          String             @unique
  isLive            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  endedAt           DateTime?
  attendanceRecords AttendanceRecord[]
  recordings        Recording[]

  @@map("live_rooms")
}

model AttendanceRecord {
  id              String    @id @default(uuid())
  roomId          String
  room            LiveRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  studentId       String
  student         User      @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  durationMinutes Int       @default(0)
  status          String    @default("PRESENT") // PRESENT, LATE, ABSENT
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([roomId, studentId])
  @@map("attendance_records")
}

model Recording {
  id              String    @id @default(uuid())
  roomId          String?
  room            LiveRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  fileName        String
  fileUrl         String
  durationSeconds Int       @default(0)
  sizeBytes       BigInt    @default(0)
  recordedAt      DateTime  @default(now())

  @@map("recordings")
}

model Announcement {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("UserAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // e.g. "LIVE_SESSION", "ASSIGNMENT", "EXAM", "ANNOUNCEMENT", "GRADE"
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model DiscussionPost {
  id        String           @id @default(uuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation("UserDiscussionPosts", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  parentId  String?
  parent    DiscussionPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   DiscussionPost[] @relation("PostReplies")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("discussion_posts")
}

model CourseMaterial {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileType    String   // "PDF", "ZIP", "DOC", "OTHER"
  sizeBytes   BigInt   @default(0)
  createdAt   DateTime @default(now())

  @@map("course_materials")
}


