# ==============================================================================
# ALPHA CLASSROOM — Backend Production Environment Configuration
# ==============================================================================
NODE_ENV=production
PORT=4000

# Database
DATABASE_URL="postgresql://alpha_user:ChangeThisSecurePasswordInProduction2026!@postgres:5432/alpha_classroom_db?schema=public"

# Authentication & Security
JWT_SECRET="replace_this_with_a_secure_random_base64_string_minimum_32_chars"
JWT_EXPIRATION="7d"

# CORS Allowed Origins (comma-separated)
FRONTEND_URL="https://classroom.yourdomain.com"

# LiveKit Media Server
LIVEKIT_API_KEY="alpha_livekit_prod_key_2026"
LIVEKIT_API_SECRET="alpha_livekit_prod_secret_replace_with_secure_string_2026"
LIVEKIT_URL="http://livekit:7880"
