# ==============================================================================
# ALPHA CLASSROOM — Production Environment Configuration (.env.production)
# ==============================================================================
# Copy this file to .env.production on your production server:
# cp .env.production.example .env.production
# Ensure file permissions are restricted: chmod 600 .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 18 Production Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=alpha_user
POSTGRES_PASSWORD=ChangeThisSecurePasswordInProduction2026!
POSTGRES_DB=alpha_classroom_db

# ------------------------------------------------------------------------------
# 2. LiveKit Real-Time WebRTC Media Server Configuration
# ------------------------------------------------------------------------------
# Generate strong 32-character alphanumeric keys for production
LIVEKIT_API_KEY=alpha_livekit_prod_key_2026
LIVEKIT_API_SECRET=alpha_livekit_prod_secret_replace_with_secure_string_2026
# Internal URL used by the NestJS backend to talk to LiveKit inside the Docker network
LIVEKIT_INTERNAL_URL=http://livekit:7880

# ------------------------------------------------------------------------------
# 3. NestJS Backend API Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Database connection string used by Prisma inside Docker network
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Security: JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=replace_this_with_a_secure_random_base64_string_minimum_32_chars
JWT_EXPIRATION=7d

# Security: Allowed CORS origins (comma-separated list of your production domains)
FRONTEND_URL=https://classroom.yourdomain.com,https://admin.yourdomain.com

# ------------------------------------------------------------------------------
# 4. Next.js 16 Web Application Frontend Configuration
# ------------------------------------------------------------------------------
# Public-facing API URL accessed from client browser (routed via Nginx reverse proxy)
NEXT_PUBLIC_API_URL=https://classroom.yourdomain.com/api/v1

# Public-facing LiveKit WebSocket URL accessed from client browser for WebRTC
NEXT_PUBLIC_LIVEKIT_URL=wss://classroom.yourdomain.com/livekit

# Frontend internal port
PORT=3000
HOSTNAME=0.0.0.0
